includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app
        - database/factories
        - database/seeders
    ignoreErrors:
        # Eloquent relation method'larında dynamic return type — Larastan'in genel davranışı
        - identifier: missingType.iterableValue
