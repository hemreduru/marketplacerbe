APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restbe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Master switch for live marketplace write operations (status/price/stock
# updates, claim approvals, answering questions). Keep false unless the
# seller has explicitly authorized writes to their live store.
MARKETPLACE_WRITE_ENABLED=false

# Kargo entegrasyonları
YURTICI_USE_TEST=true
# YURTICI_PRODUCTION_WSDL=
# YURTICI_TRACKING_PRODUCTION_WSDL=
# ARAS_REST_ENDPOINT=https://esasweb.araskargo.com.tr
# ARAS_WEBHOOK_ALLOWED_IPS=

# Trendyol webhook güvenliği: yalnızca bu IP'lerden gelen istekleri kabul et.
# Virgülle ayırarak birden fazla IP belirtebilirsiniz (örn: 192.168.1.1,10.0.0.1).
# Boş bırakılırsa tüm IP'lere izin verilir (geriye dönük uyumlu).
TRENDYOL_WEBHOOK_ALLOWED_IPS=
# MNG_PRODUCTION_WSDL=
# SURAT_PRODUCTION_WSDL=
# PTT_REST_ENDPOINT=
CARGO_TRACKING_POLL_ENABLED=false
CARGO_TRACKING_POLL_INTERVAL=60

# E-Fatura entegrasyonları
# PARASUT_BASE_URL=https://api.parasut.com/v4
# BIZIM_HESAP_BASE_URL=https://api.bizimhesap.com
# GIB_EFATURA_BASE_URL=

# Faz 4 — Analitik 2.0 (reklam, buybox, kargo e-ihracat)
# Reklam API endpoint'leri (Trendyol Ads / HB Sponsor) — canlı entegrasyon ileri PR
# TRENDYOL_ADS_CAMPAIGNS_ENDPOINT=
# HEPSIBURADA_SPONSOR_ENDPOINT=
# Buybox API endpoint (Trendyol) — canlı entegrasyon ileri PR
# TRENDYOL_BUYBOX_ENDPOINT=
# UPS (e-ihracat)
# UPS_TEST_ENDPOINT=https://wwwcie.ups.com/api
# UPS_PRODUCTION_ENDPOINT=https://onlinetools.ups.com/api
# DHL (e-ihracat)
# DHL_TEST_ENDPOINT=https://api-sandbox.dhl.com
# DHL_PRODUCTION_ENDPOINT=https://api.dhl.com

# Hepsiburada
HB_USE_STAGE=true
HB_STAGE_BASE_URL=https://mpop-sit.hepsiburada.com
HB_PRODUCTION_BASE_URL=https://mpop.hepsiburada.com
HB_WEBHOOK_ALLOWED_IPS=
HB_SETTLEMENTS_PATH=/finances/merchants/{merchantId}/transactions

# Kar motoru / mutabakat
STOPAJ_RATE=1.0
FINANCE_RETURN_WINDOW_DAYS=15
FINANCE_DEVIATION_THRESHOLD=2.0

# iyzico (abonelik ödemesi 3DS) — CANLI anahtar için sandbox hesabı gerekli (procurement)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox.iyzipay.com
IYZICO_DEBUG=true
